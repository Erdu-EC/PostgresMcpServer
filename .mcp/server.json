{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "description": "MCP server for PostgreSQL with query and execute tools, fully Native AOT compatible.",
  "name": "postgres-mcp",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "nuget",
      "identifier": "PostgresMcpServer",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [],
      "environmentVariables": [
        {
          "name": "PGCONNECTIONSTRING",
          "description": "PostgreSQL connection string (e.g. Host=localhost;Port=5432;Database=mydb;Username=user;Password=pass;)"
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/user/PostgresMcpServer",
    "source": "github"
  }
}
